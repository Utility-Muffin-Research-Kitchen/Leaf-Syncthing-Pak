{
  "id": "org.umrk.syncthing",
  "name": "Syncthing",
  "platform": "mlp1",
  "pak_version": "0.1.1",
  "min_leaf_version": "0.10.0",
  "min_jawaka_version": "0.5.5",
  "author": "Utility Muffin Research Kitchen",
  "repo_url": "https://github.com/Utility-Muffin-Research-Kitchen/Leaf-Syncthing-Pak",
  "description": "Managed save synchronization for Leaf with protected first sync and safe game-launch handoff.",
  "service": {
    "schema": 1,
    "id": "org.umrk.syncthing",
    "run": {
      "path": "service.sh",
      "args": []
    },
    "restart": "on-failure",
    "default_enabled": false,
    "stop_grace_ms": 10000,
    "lifecycle": {
      "game": "stop",
      "stop_on_storage_change": true,
      "stop_on_suspend": true
    }
  },
  "state": {
    "root": "Syncthing",
    "revoke_on_uninstall": ["leaf/trusted-clients.json"],
    "retained_roots": ["Syncthing"]
  }
}
